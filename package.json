{
  "name": "busboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "import": "tsx scripts/import-csv.ts",
    "export-csv": "tsx scripts/export-csv.ts",
    "validate:examples": "tsx scripts/validate.ts examples/chitose && tsx scripts/validate.ts examples/sample-univ",
    "test": "npm run validate:examples && tsx scripts/test.ts && tsx scripts/test-csv.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
